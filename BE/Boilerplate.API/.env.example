# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development #Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# PostgreSQL
Database__ConnectionString=Host=localhost;Port=5432;Database=boilerplate;Username=postgres;Password=change_me

# JWT
# Replace this value with a random secret containing at least 32 UTF-8 bytes.
Jwt__SecretKey=replace-with-a-random-secret-at-least-32-bytes
Jwt__Issuer=Boilerplate.API
Jwt__Audience=Boilerplate.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Refresh-token cookie
# Use true in production. SameSite=None also requires Secure=true and HTTPS.
Jwt__RefreshCookieName=boilerplate_refresh_token
Jwt__RefreshCookieSecure=false
Jwt__RefreshCookieSameSite=Strict

# CORS (origins allowed for frontend)
Cors__AllowedOrigins__0=http://localhost:3000
